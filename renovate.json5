{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Shared policy: https://github.com/seijikohara/renovate-config
  extends: ['github>seijikohara/renovate-config:default.json5'],
  packageRules: [
    {
      // oxlint declares the oxlint-tsgolint version it needs as a peer dependency,
      // and oxlint-tsgolint moves to a new major with TypeScript. Keep majors in the
      // same PR so oxlint never lands without a matching oxlint-tsgolint.
      description: 'Group the oxc linting and formatting toolchain',
      groupName: 'linting and formatting',
      matchPackageNames: ['oxlint', 'oxfmt', 'oxlint-tsgolint'],
      separateMajorMinor: false,
    },
    {
      description: 'Group the test toolchain',
      groupName: 'testing',
      matchPackageNames: ['vitest', '@vitest/*'],
    },
    {
      description: 'Group the build toolchain',
      groupName: 'build toolchain',
      matchPackageNames: [
        'typescript',
        'tsdown',
        'lefthook',
        'publint',
        '@arethetypeswrong/*',
        'taze',
      ],
    },
  ],
}
